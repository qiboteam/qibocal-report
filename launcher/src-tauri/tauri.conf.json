{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qibocal Launcher",
  "version": "0.1.0",
  "identifier": "science.qibo.qibocal.launcher",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Qibocal Launcher",
        "width": 1180,
        "height": 840,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Launch and manage Qibocal report servers",
    "longDescription": "Spawn Qibocal report servers and notebook sessions, manage local configurations and administrator invitations, and explore calibration reports in the bundled dashboard.",
    "copyright": "Apache-2.0 - Qibo Team",
    "publisher": "Qibo Team",
    "homepage": "https://qibo.science/qibocal-report",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
